# Shared local defaults. Copy to .env and replace every placeholder.
# Never commit .env or real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Prefer the direct connection (port 5432) for migrations. URL-encode special
# characters in the database password.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Create this user in Supabase Authentication first, then paste its UUID here.
SEED_REP_USER_ID=00000000-0000-0000-0000-000000000000
