# Copy to apps/web/.env.local. Values prefixed NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only. Never prefix this value with NEXT_PUBLIC_ and never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Used only by server-side database adapters and operational scripts.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
